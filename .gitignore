# Load-bearing: gate.py's clean-tree check fails on any untracked file, and
# pytest --cov creates several.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.venv/
venv/

# Real hand histories are personal data and are never committed.
/data/hh/*
!/data/hh/.gitkeep

# Third-party reference data (docs/gate-d-reference.md). No redistribution licence
# for the HRC file, so neither is committed; tests pin their SHA-256.
/data/external/

# The flop library: large, rebuilt from the AGPL bridge, never committed (DECISIONS 40).
/data/library/

# Local Claude Code launch config for the play-page preview; machine-specific.
/.claude/

# The live advisor's hand log is personal play data and is never committed (DECISIONS 32).
/data/live/

# Six-max drill logs are personal study data and are never committed (DECISIONS 55).
/data/drills/

# TexasSolver writes its iteration log to its working directory (spike S2).
/tmp_log.txt
